# CEH network range: Kali attacker + Metasploitable2 target on a host-only net.
#   vagrant up            bring both up
#   vagrant ssh kali      attacker shell
#   vagrant halt          stop      vagrant destroy   remove
#
# Host-only network 192.168.56.0/24 (VirtualBox default host-only range).
# Nothing here is NAT-forwarded to the internet by design.

Vagrant.configure("2") do |config|

  # ---- Attacker: Kali Linux (official rolling box) --------------------------
  # Box: https://portal.cloud.hashicorp.com/vagrant/discover/kalilinux/rolling
  config.vm.define "kali" do |kali|
    kali.vm.box = "kalilinux/rolling"
    kali.vm.hostname = "kali"
    kali.vm.network "private_network", ip: "192.168.56.10"
    kali.vm.provider "virtualbox" do |vb|
      vb.name = "ceh-kali"
      vb.memory = 4096
      vb.cpus = 2
      vb.gui = true            # Kali ships a desktop; set false for headless + ssh
    end
    kali.vm.provision "shell", inline: <<-SHELL
      apt-get update
      # Add/verify the core toolset used across the modules
      apt-get install -y nmap metasploit-framework hydra john sqlmap \
        dirb nikto enum4linux smbclient responder wireshark tshark \
        hashcat seclists 2>/dev/null || true
    SHELL
  end

  # ---- Target: Metasploitable2 ---------------------------------------------
  # Metasploitable2 is distributed as a VMDK/OVA, not an official Vagrant box.
  # Two supported options — pick ONE and see vagrant/README.md:
  #
  #   (A) Community Vagrant box (verify it still exists before relying on it):
  #         config.vm.box = "rapid7/metasploitable3-ub1404"   # metasploitable3
  #   (B) Import the official Metasploitable2 VMDK/OVA manually, then attach a
  #       host-only adapter at 192.168.56.20. (Recommended, fully offline.)
  #
  # The stanza below assumes option (A); comment it out if you import manually.
  config.vm.define "metasploitable", autostart: true do |ms|
    ms.vm.box = "rapid7/metasploitable3-ub1404"
    ms.vm.hostname = "metasploitable"
    ms.vm.network "private_network", ip: "192.168.56.20"
    ms.vm.provider "virtualbox" do |vb|
      vb.name = "ceh-metasploitable"
      vb.memory = 2048
      vb.cpus = 1
    end
  end

end
